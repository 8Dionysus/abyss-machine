{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abyss-machine.local/schemas/pytest-owner-lifecycle-census-evidence-v1.schema.json",
  "title": "Owner lifecycle census evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "request_digest",
    "scan_scope",
    "target_snapshot_digest",
    "target_identities",
    "processes",
    "bounds",
    "scan_started_ns",
    "scan_completed_ns",
    "complete",
    "backend_id",
    "backend_version",
    "reason",
    "evidence_digest"
  ],
  "properties": {
    "schema": {"const": "pytest-owner-lifecycle-census-evidence-v1"},
    "request_id": {"$ref": "#/$defs/text"},
    "request_digest": {"$ref": "#/$defs/digest"},
    "scan_scope": {"$ref": "#/$defs/text"},
    "target_snapshot_digest": {"$ref": "#/$defs/digest"},
    "target_identities": {"type": "array", "maxItems": 65536, "items": {"$ref": "#/$defs/identity"}},
    "processes": {
      "type": "array",
      "maxItems": 65536,
      "items": {"$ref": "#/$defs/process"},
      "description": "The sum of every process.descriptors array is bounded by bounds.max_descriptors; the implementation rejects any aggregate overflow before nested descriptor objects are materialized."
    },
    "bounds": {"$ref": "#/$defs/bounds"},
    "scan_started_ns": {"type": "integer", "minimum": 1},
    "scan_completed_ns": {"type": "integer", "minimum": 1},
    "complete": {"type": "boolean"},
    "backend_id": {"$ref": "#/$defs/text"},
    "backend_version": {"$ref": "#/$defs/text"},
    "reason": {"type": "string", "maxLength": 512, "pattern": "^[^\\u0000]*$"},
    "evidence_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000]*$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "identity": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0},
        {"type": "string", "enum": ["directory", "regular", "symlink", "special", "other"]}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "process_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pid", "start_ticks", "boot_id", "run_id"],
      "properties": {
        "pid": {"type": "integer", "minimum": 1},
        "start_ticks": {"type": "integer", "minimum": 1},
        "boot_id": {"$ref": "#/$defs/text"},
        "run_id": {"$ref": "#/$defs/text"}
      }
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "fd_number", "dev", "ino", "mount_id", "object_kind", "deleted"],
      "properties": {
        "kind": {"type": "string", "enum": ["cwd", "root", "fd"]},
        "fd_number": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "dev": {"type": "integer", "minimum": 0},
        "ino": {"type": "integer", "minimum": 0},
        "mount_id": {"type": "integer", "minimum": 0},
        "object_kind": {"type": "string", "enum": ["directory", "regular", "symlink", "special", "other"]},
        "deleted": {"type": "boolean"}
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["process", "descriptors", "uid"],
      "properties": {
        "process": {"$ref": "#/$defs/process_identity"},
        "descriptors": {
          "type": "array",
          "maxItems": 262144,
          "items": {"$ref": "#/$defs/descriptor"},
          "description": "This is only the absolute wire ceiling; the applicable bounds.max_descriptors is one aggregate limit across all processes."
        },
        "uid": {"type": "integer", "minimum": 0}
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_processes", "max_descriptors", "max_target_identities", "max_duration_ns"],
      "properties": {
        "max_processes": {"type": "integer", "minimum": 1, "maximum": 65536},
        "max_descriptors": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144,
          "description": "The single aggregate descriptor limit applied across every admitted process cwd/root/fd evidence."
        },
        "max_target_identities": {"type": "integer", "minimum": 1, "maximum": 65536},
        "max_duration_ns": {"type": "integer", "minimum": 1, "maximum": 300000000000}
      }
    }
  }
}
