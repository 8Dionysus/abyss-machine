{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/8Dionysus/abyss-machine/main/schemas/active-organ-host-erasure-owner-extension-v0.schema.json",
  "title": "abyss-machine Phase 11 host erasure owner extension v0",
  "description": "Reference-lab-only ER6 host evidence bounded to abyss-machine-managed roots.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "extension_id",
    "parent_owner",
    "worker_owner",
    "surface_id",
    "work_item_ref",
    "material_classes",
    "target_ref_digests",
    "operation_evidence_refs",
    "recovery_probe_ref",
    "result",
    "residue_refs",
    "retention_exceptions",
    "target_root_class",
    "host_path_disclosed",
    "physical_evidence_ref",
    "rebuild_recovery_checked",
    "project_root_mutation",
    "stack_root_mutation",
    "subject_material_included",
    "content_minimized",
    "execution_posture",
    "live_execution",
    "effect_authority",
    "global_completion_authority",
    "content_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "active_organ_owner_erasure_extension_v0"
    },
    "extension_id": {
      "$ref": "#/$defs/ref"
    },
    "parent_owner": {
      "const": "abyss-machine"
    },
    "worker_owner": {
      "const": "abyss-machine"
    },
    "surface_id": {
      "const": "ER6"
    },
    "work_item_ref": {
      "$ref": "#/$defs/ref"
    },
    "material_classes": {
      "const": [
        "host_local_surface"
      ]
    },
    "target_ref_digests": {
      "$ref": "#/$defs/digests"
    },
    "operation_evidence_refs": {
      "$ref": "#/$defs/refs"
    },
    "recovery_probe_ref": {
      "$ref": "#/$defs/ref"
    },
    "result": {
      "enum": [
        "erased",
        "residue",
        "partial",
        "failed"
      ]
    },
    "residue_refs": {
      "$ref": "#/$defs/refs_optional"
    },
    "retention_exceptions": {
      "type": "array"
    },
    "target_root_class": {
      "enum": [
        "etc_abyss_machine",
        "srv_abyss_machine"
      ]
    },
    "host_path_disclosed": {
      "const": false
    },
    "physical_evidence_ref": {
      "$ref": "#/$defs/ref"
    },
    "rebuild_recovery_checked": {
      "const": true
    },
    "project_root_mutation": {
      "const": "forbidden"
    },
    "stack_root_mutation": {
      "const": "forbidden"
    },
    "subject_material_included": {
      "const": false
    },
    "content_minimized": {
      "const": true
    },
    "execution_posture": {
      "const": "reference_lab_only"
    },
    "live_execution": {
      "const": false
    },
    "effect_authority": {
      "const": "owner_local_erasure_only"
    },
    "global_completion_authority": {
      "const": false
    },
    "content_digest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "digests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "refs_optional": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ref"
      }
    }
  }
}
