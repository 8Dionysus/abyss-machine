{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/8Dionysus/abyss-machine/schemas/storage-policy.schema.json",
  "title": "abyss-machine storage policy",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "roots": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "classes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "forbidden_public_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "secondary_write_routes": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "root",
          "kind",
          "owner_uid",
          "mount"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "root": {
            "type": "string",
            "pattern": "^/"
          },
          "kind": {
            "const": "benchmark"
          },
          "owner_uid": {
            "type": "integer",
            "minimum": 0
          },
          "mount": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mountpoint",
              "device",
              "filesystem",
              "source",
              "root"
            ],
            "properties": {
              "mountpoint": {
                "type": "string",
                "minLength": 1
              },
              "device": {
                "type": "string",
                "minLength": 1
              },
              "filesystem": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "root": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
