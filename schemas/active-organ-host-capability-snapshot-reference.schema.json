{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/8Dionysus/abyss-machine/schemas/active-organ-host-capability-snapshot-reference.schema.json",
  "title": "OS Abyss active-organ host capability snapshot reference",
  "description": "C18 reference-only host evidence envelope. It carries sanitized refs, never raw host facts or authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "contract_name",
    "reference_id",
    "reference_version",
    "idempotency_key",
    "owner",
    "host_identity_digest",
    "snapshot_generation",
    "captured_at",
    "produced_at",
    "expires_at",
    "freshness_state",
    "capture_command_ref",
    "capability_refs",
    "source_refs",
    "policy_pin",
    "allowed_consumers",
    "validation_status",
    "privacy_class",
    "public_safe",
    "raw_host_data_included",
    "content_digest",
    "evidence_only",
    "semantic_authority",
    "effect_authority"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "contract_id": {
      "const": "C18"
    },
    "contract_name": {
      "const": "HostCapabilitySnapshotReference"
    },
    "reference_id": {
      "type": "string",
      "minLength": 1
    },
    "reference_version": {
      "type": "integer",
      "minimum": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "const": "abyss-machine"
    },
    "host_identity_digest": {
      "$ref": "#/$defs/digest"
    },
    "snapshot_generation": {
      "type": "string",
      "minLength": 1
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "produced_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "freshness_state": {
      "enum": [
        "current",
        "stale",
        "unknown"
      ]
    },
    "capture_command_ref": {
      "$ref": "#/$defs/provenance_ref"
    },
    "capability_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/capability_ref"
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/provenance_ref"
      }
    },
    "policy_pin": {
      "$ref": "#/$defs/policy_pin"
    },
    "allowed_consumers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "aoa-sdk",
          "abyss-stack",
          "aoa-evals"
        ]
      }
    },
    "validation_status": {
      "enum": [
        "valid",
        "partial",
        "failed",
        "invalid"
      ]
    },
    "privacy_class": {
      "enum": [
        "D0",
        "D1"
      ]
    },
    "public_safe": {
      "const": true
    },
    "raw_host_data_included": {
      "const": false
    },
    "content_digest": {
      "$ref": "#/$defs/digest"
    },
    "evidence_only": {
      "const": true
    },
    "semantic_authority": {
      "const": "none"
    },
    "effect_authority": {
      "const": "none"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "provenance_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_repo",
        "artifact_ref",
        "artifact_version",
        "artifact_digest"
      ],
      "properties": {
        "owner_repo": {
          "type": "string",
          "minLength": 1
        },
        "artifact_ref": {
          "type": "string",
          "minLength": 1
        },
        "artifact_version": {
          "type": "string",
          "minLength": 1
        },
        "artifact_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "policy_pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "policy_version",
        "decision_ref",
        "policy_digest"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "decision_ref": {
          "type": "string",
          "minLength": 1
        },
        "policy_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "capability_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_class",
        "artifact",
        "observed_at",
        "freshness_state",
        "sanitized_aggregate"
      ],
      "properties": {
        "capability_class": {
          "enum": [
            "cpu",
            "memory",
            "storage",
            "thermal",
            "npu",
            "gpu",
            "network",
            "power",
            "runtime",
            "container",
            "security",
            "other"
          ]
        },
        "artifact": {
          "$ref": "#/$defs/provenance_ref"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "freshness_state": {
          "enum": [
            "current",
            "stale",
            "unknown"
          ]
        },
        "sanitized_aggregate": {
          "type": "boolean"
        }
      }
    }
  }
}
