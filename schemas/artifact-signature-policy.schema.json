{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/8Dionysus/abyss-machine/schemas/artifact-signature-policy.schema.json",
  "title": "abyss-machine artifact signature policy",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "policy_version",
    "abi_signature",
    "identity_fields",
    "local_provenance_packet",
    "portable_runner_contract",
    "producer_profiles",
    "release_sidecar_expectations",
    "artifact_classes",
    "contract_surfaces",
    "release_artifact_rules",
    "deferred_trust_layers"
  ],
  "properties": {
    "schema": {
      "const": "abyss_machine_artifact_signature_policy_manifest_v1"
    },
    "policy_version": {
      "type": "string"
    },
    "abi_signature": {
      "type": "object",
      "additionalProperties": true,
      "required": ["algorithm", "generated_surface"],
      "properties": {
        "algorithm": {"const": "sha256-tree-v1"},
        "generated_surface": {"type": "string"}
      }
    },
    "identity_fields": {
      "type": "array",
      "items": {"type": "string"}
    },
    "local_provenance_packet": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema",
        "schema_ref",
        "applies_to_artifact_classes",
        "storage_route",
        "not_public_repo_content",
        "required_fields",
        "consumer_checks",
        "promotion_controls"
      ],
      "properties": {
        "schema": {"const": "abyss_machine_local_provenance_packet_v1"},
        "schema_ref": {"type": "string"},
        "applies_to_artifact_classes": {
          "type": "array",
          "items": {"type": "string"}
        },
        "storage_route": {"type": "string"},
        "not_public_repo_content": {"const": true},
        "required_fields": {
          "type": "array",
          "items": {"type": "string"}
        },
        "consumer_checks": {
          "type": "array",
          "items": {"type": "string"}
        },
        "promotion_controls": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "artifact_classes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "required": ["description", "identity"],
        "properties": {
          "identity": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "artifact_class",
              "surface_state",
              "owner_repo",
              "authority_ref",
              "producer",
              "consumer_expectation",
              "privacy_boundary",
              "content_identity",
              "abi_epoch",
              "contract_version",
              "trust_layer",
              "verification",
              "action"
            ],
            "properties": {
              "authority_ref": {
                "type": "array",
                "items": {"type": "string"}
              },
              "trust_layer": {
                "type": "array",
                "items": {"type": "string"}
              },
              "verification": {
                "type": "array",
                "items": {"type": "string"}
              }
            }
          },
          "producer_admission": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "canonical_profile_id",
              "canonical_owner_repo",
              "single_canonical_owner",
              "canonical_switch_requires_explicit_policy_update",
              "canonical_profile",
              "candidate_profiles"
            ],
            "properties": {
              "canonical_profile_id": {
                "type": "string",
                "minLength": 1
              },
              "canonical_owner_repo": {
                "type": "string",
                "minLength": 1
              },
              "single_canonical_owner": {
                "const": true
              },
              "canonical_switch_requires_explicit_policy_update": {
                "const": true
              },
              "canonical_profile": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "profile_id",
                  "owner_repo",
                  "source_ref",
                  "manifest_mode",
                  "lifecycle_initial_state",
                  "manifest_promotion_path",
                  "manifest_latest_eligible_states",
                  "artifact_source_kind",
                  "provenance_subject_ref",
                  "provenance_schema",
                  "provenance_state",
                  "publication_posture",
                  "predecessor_owner_repo",
                  "predecessor_source_ref",
                  "predecessor_posture",
                  "owner_switch_receipt_ref",
                  "owner_switch_receipt_schema",
                  "owner_switch_receipt_digest",
                  "owner_switch_receipt_status",
                  "sdk_version",
                  "abi_epoch",
                  "public_release_source_ref",
                  "public_release_ref",
                  "public_release_asset_name",
                  "public_release_asset_digest",
                  "canonical_release_ref",
                  "canonical_release_asset_name",
                  "canonical_release_asset_digest",
                  "canonical_release_archive_prefix",
                  "canonical_release_manifest_ref",
                  "canonical_release_manifest_digest",
                  "canonical_release_member_set_digest",
                  "canonical_release_subject_count",
                  "canonical_release_artifact_subjects_digest",
                  "canonical_release_evidence_schema",
                  "canonical_release_evidence_ref",
                  "canonical_release_verifier",
                  "stronger_owner",
                  "trust_admission_status",
                  "runtime_consumer",
                  "runtime_consumer_source_ref",
                  "runtime_consumer_decision_id",
                  "allowed_registry_lifecycle_states",
                  "allowed_trust_root_modes",
                  "allowed_consumer_intents",
                  "required_g5_authority",
                  "archive_stop_line"
                ],
                "properties": {
                  "profile_id": {"type": "string", "minLength": 1},
                  "owner_repo": {"type": "string", "minLength": 1},
                  "source_ref": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
                  "manifest_mode": {"const": "github_release"},
                  "lifecycle_initial_state": {"const": "release-ready"},
                  "manifest_promotion_path": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {"type": "string", "minLength": 1}
                  },
                  "manifest_latest_eligible_states": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {"type": "string", "minLength": 1}
                  },
                  "artifact_source_kind": {"type": "string", "minLength": 1},
                  "provenance_subject_ref": {"type": "string", "minLength": 1},
                  "provenance_schema": {"type": "string", "minLength": 1},
                  "provenance_state": {"type": "string", "minLength": 1},
                  "publication_posture": {"const": "public_release_canonical"},
                  "predecessor_owner_repo": {"type": "string", "minLength": 1},
                  "predecessor_source_ref": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
                  "predecessor_posture": {"type": "string", "minLength": 1},
                  "owner_switch_receipt_ref": {"type": "string", "minLength": 1},
                  "owner_switch_receipt_schema": {"type": "string", "minLength": 1},
                  "owner_switch_receipt_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                  "owner_switch_receipt_status": {"type": "string", "minLength": 1},
                  "sdk_version": {"type": "string", "minLength": 1},
                  "abi_epoch": {"type": "string", "minLength": 1},
                  "public_release_source_ref": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
                  "public_release_ref": {"type": "string", "minLength": 1},
                  "public_release_asset_name": {"type": "string", "minLength": 1},
                  "public_release_asset_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                  "canonical_release_ref": {"type": "string", "minLength": 1},
                  "canonical_release_asset_name": {"type": "string", "minLength": 1},
                  "canonical_release_asset_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                  "canonical_release_archive_prefix": {"type": "string", "minLength": 1},
                  "canonical_release_manifest_ref": {"type": "string", "minLength": 1},
                  "canonical_release_manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                  "canonical_release_member_set_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                  "canonical_release_subject_count": {"type": "integer", "minimum": 1},
                  "canonical_release_artifact_subjects_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                  "canonical_release_evidence_schema": {"type": "string", "minLength": 1},
                  "canonical_release_evidence_ref": {"type": "string", "minLength": 1},
                  "canonical_release_verifier": {"type": "string", "minLength": 1},
                  "stronger_owner": {"type": "string", "minLength": 1},
                  "trust_admission_status": {"type": "string", "minLength": 1},
                  "runtime_consumer": {"type": "string", "minLength": 1},
                  "runtime_consumer_source_ref": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
                  "runtime_consumer_decision_id": {"type": "string", "minLength": 1},
                  "allowed_registry_lifecycle_states": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {"enum": ["release-ready", "published", "superseded", "revoked"]}
                  },
                  "allowed_trust_root_modes": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {"const": "public_release"}
                  },
                  "allowed_consumer_intents": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {"enum": ["release_consumer", "runtime_canary", "runtime"]}
                  },
                  "required_g5_authority": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {"type": "boolean"}
                  },
                  "archive_stop_line": {"type": "string", "minLength": 1}
                }
              },
              "candidate_profiles": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "profile_id",
                    "owner_repo",
                    "manifest_mode",
                    "lifecycle_initial_state",
                    "manifest_promotion_path",
                    "manifest_latest_eligible_states",
                    "artifact_source_kind",
                    "provenance_subject_ref",
                    "provenance_state",
                    "publication_posture",
                    "current_canonical_owner_repo",
                    "stronger_owner",
                    "trust_admission_status",
                    "runtime_consumer",
                    "allowed_registry_lifecycle_states",
                    "allowed_trust_root_modes",
                    "allowed_consumer_intents",
                    "required_false_authority_flags"
                  ],
                  "properties": {
                    "profile_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "owner_repo": {
                      "type": "string",
                      "minLength": 1
                    },
                    "manifest_mode": {
                      "enum": ["os_abyss_local", "github_release"]
                    },
                    "lifecycle_initial_state": {
                      "enum": ["candidate", "release-ready"]
                    },
                    "manifest_promotion_path": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {"type": "string", "minLength": 1}
                    },
                    "manifest_latest_eligible_states": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {"type": "string", "minLength": 1}
                    },
                    "artifact_source_kind": {
                      "type": "string",
                      "minLength": 1
                    },
                    "provenance_subject_ref": {
                      "type": "string",
                      "minLength": 1
                    },
                    "provenance_state": {
                      "type": "string",
                      "minLength": 1
                    },
                    "publication_posture": {
                      "enum": ["non_publishing_canary", "public_release_candidate"]
                    },
                    "current_canonical_owner_repo": {
                      "type": "string",
                      "minLength": 1
                    },
                    "stronger_owner": {
                      "type": "string",
                      "minLength": 1
                    },
                    "trust_admission_status": {
                      "type": "string",
                      "minLength": 1
                    },
                    "runtime_consumer": {
                      "type": "string",
                      "minLength": 1
                    },
                    "allowed_registry_lifecycle_states": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "enum": ["manually-verified", "release-ready", "published", "superseded", "revoked"]
                      }
                    },
                    "allowed_trust_root_modes": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "enum": ["local_dev", "host_managed", "public_release"]
                      }
                    },
                    "allowed_consumer_intents": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "enum": ["agent", "release_consumer", "runtime_canary"]
                      }
                    },
                    "required_false_authority_flags": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "portable_runner_contract": {
      "type": "object",
      "additionalProperties": true,
      "required": ["entrypoint_sources", "runner_contexts", "required_entrypoints"],
      "properties": {
        "entrypoint_sources": {
          "type": "array",
          "items": {"type": "string"}
        },
        "runner_contexts": {
          "type": "array",
          "items": {"type": "string"}
        },
        "required_entrypoints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["id", "command"],
            "properties": {
              "id": {"type": "string"},
              "command": {
                "type": "array",
                "items": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "producer_profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "profile_id",
          "owner_repo",
          "owner_route_refs",
          "artifact_classes",
          "release_export_triggers",
          "validator_commands",
          "produced_sidecars",
          "consumer_expectations",
          "owner_boundaries",
          "trust_root_modes"
        ],
        "properties": {
          "profile_id": {"type": "string"},
          "owner_repo": {"type": "string"},
          "owner_route_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "artifact_classes": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "release_export_triggers": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "validator_commands": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "produced_sidecars": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "consumer_expectations": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "owner_boundaries": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "trust_root_modes": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          }
        }
      }
    },
    "release_sidecar_expectations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "required": ["consumer_checks"],
        "properties": {
          "consumer_checks": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          }
        }
      }
    },
    "contract_surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "epoch", "artifact_class", "source_paths"],
        "properties": {
          "id": {"type": "string"},
          "epoch": {"type": "string"},
          "artifact_class": {"type": "string"},
          "source_paths": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "release_artifact_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "artifact_class", "artifact_patterns", "public_repo_policy", "required_controls"],
        "properties": {
          "id": {"type": "string"},
          "artifact_class": {"type": "string"},
          "artifact_patterns": {
            "type": "array",
            "items": {"type": "string"}
          },
          "public_repo_policy": {"type": "string"},
          "required_controls": {
            "type": "array",
            "items": {"type": "string"}
          },
          "sidecar_extensions": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {"type": "string"}
            }
          }
        }
      }
    },
    "deferred_trust_layers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "required": ["trigger", "action", "reason"]
      }
    }
  }
}
