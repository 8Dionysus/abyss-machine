{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/8Dionysus/abyss-machine/schemas/artifact-signature-policy.schema.json",
  "title": "abyss-machine artifact signature policy",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "policy_version",
    "abi_signature",
    "identity_fields",
    "local_provenance_packet",
    "portable_runner_contract",
    "producer_profiles",
    "release_sidecar_expectations",
    "artifact_classes",
    "contract_surfaces",
    "release_artifact_rules",
    "deferred_trust_layers"
  ],
  "properties": {
    "schema": {
      "const": "abyss_machine_artifact_signature_policy_manifest_v1"
    },
    "policy_version": {
      "type": "string"
    },
    "abi_signature": {
      "type": "object",
      "additionalProperties": true,
      "required": ["algorithm", "generated_surface"],
      "properties": {
        "algorithm": {"const": "sha256-tree-v1"},
        "generated_surface": {"type": "string"}
      }
    },
    "identity_fields": {
      "type": "array",
      "items": {"type": "string"}
    },
    "local_provenance_packet": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema",
        "schema_ref",
        "applies_to_artifact_classes",
        "storage_route",
        "not_public_repo_content",
        "required_fields",
        "consumer_checks",
        "promotion_controls"
      ],
      "properties": {
        "schema": {"const": "abyss_machine_local_provenance_packet_v1"},
        "schema_ref": {"type": "string"},
        "applies_to_artifact_classes": {
          "type": "array",
          "items": {"type": "string"}
        },
        "storage_route": {"type": "string"},
        "not_public_repo_content": {"const": true},
        "required_fields": {
          "type": "array",
          "items": {"type": "string"}
        },
        "consumer_checks": {
          "type": "array",
          "items": {"type": "string"}
        },
        "promotion_controls": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "artifact_classes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "required": ["description", "identity"],
        "properties": {
          "identity": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "artifact_class",
              "surface_state",
              "owner_repo",
              "authority_ref",
              "producer",
              "consumer_expectation",
              "privacy_boundary",
              "content_identity",
              "abi_epoch",
              "contract_version",
              "trust_layer",
              "verification",
              "action"
            ],
            "properties": {
              "authority_ref": {
                "type": "array",
                "items": {"type": "string"}
              },
              "trust_layer": {
                "type": "array",
                "items": {"type": "string"}
              },
              "verification": {
                "type": "array",
                "items": {"type": "string"}
              }
            }
          },
          "producer_admission": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "canonical_profile_id",
              "canonical_owner_repo",
              "single_canonical_owner",
              "canonical_switch_requires_explicit_policy_update",
              "candidate_profiles"
            ],
            "properties": {
              "canonical_profile_id": {
                "type": "string",
                "minLength": 1
              },
              "canonical_owner_repo": {
                "type": "string",
                "minLength": 1
              },
              "single_canonical_owner": {
                "const": true
              },
              "canonical_switch_requires_explicit_policy_update": {
                "const": true
              },
              "candidate_profiles": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "profile_id",
                    "owner_repo",
                    "manifest_mode",
                    "lifecycle_initial_state",
                    "artifact_source_kind",
                    "provenance_subject_ref",
                    "provenance_state",
                    "publication_posture",
                    "current_canonical_owner_repo",
                    "stronger_owner",
                    "trust_admission_status",
                    "runtime_consumer",
                    "required_false_authority_flags"
                  ],
                  "properties": {
                    "profile_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "owner_repo": {
                      "type": "string",
                      "minLength": 1
                    },
                    "manifest_mode": {
                      "enum": ["os_abyss_local"]
                    },
                    "lifecycle_initial_state": {
                      "enum": ["candidate"]
                    },
                    "artifact_source_kind": {
                      "type": "string",
                      "minLength": 1
                    },
                    "provenance_subject_ref": {
                      "type": "string",
                      "minLength": 1
                    },
                    "provenance_state": {
                      "type": "string",
                      "minLength": 1
                    },
                    "publication_posture": {
                      "enum": ["non_publishing_canary"]
                    },
                    "current_canonical_owner_repo": {
                      "type": "string",
                      "minLength": 1
                    },
                    "stronger_owner": {
                      "type": "string",
                      "minLength": 1
                    },
                    "trust_admission_status": {
                      "type": "string",
                      "minLength": 1
                    },
                    "runtime_consumer": {
                      "type": "string",
                      "minLength": 1
                    },
                    "required_false_authority_flags": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "portable_runner_contract": {
      "type": "object",
      "additionalProperties": true,
      "required": ["entrypoint_sources", "runner_contexts", "required_entrypoints"],
      "properties": {
        "entrypoint_sources": {
          "type": "array",
          "items": {"type": "string"}
        },
        "runner_contexts": {
          "type": "array",
          "items": {"type": "string"}
        },
        "required_entrypoints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["id", "command"],
            "properties": {
              "id": {"type": "string"},
              "command": {
                "type": "array",
                "items": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "producer_profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "profile_id",
          "owner_repo",
          "owner_route_refs",
          "artifact_classes",
          "release_export_triggers",
          "validator_commands",
          "produced_sidecars",
          "consumer_expectations",
          "owner_boundaries",
          "trust_root_modes"
        ],
        "properties": {
          "profile_id": {"type": "string"},
          "owner_repo": {"type": "string"},
          "owner_route_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "artifact_classes": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "release_export_triggers": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "validator_commands": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "produced_sidecars": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "consumer_expectations": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "owner_boundaries": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "trust_root_modes": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          }
        }
      }
    },
    "release_sidecar_expectations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "required": ["consumer_checks"],
        "properties": {
          "consumer_checks": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          }
        }
      }
    },
    "contract_surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "epoch", "artifact_class", "source_paths"],
        "properties": {
          "id": {"type": "string"},
          "epoch": {"type": "string"},
          "artifact_class": {"type": "string"},
          "source_paths": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "release_artifact_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "artifact_class", "artifact_patterns", "public_repo_policy", "required_controls"],
        "properties": {
          "id": {"type": "string"},
          "artifact_class": {"type": "string"},
          "artifact_patterns": {
            "type": "array",
            "items": {"type": "string"}
          },
          "public_repo_policy": {"type": "string"},
          "required_controls": {
            "type": "array",
            "items": {"type": "string"}
          },
          "sidecar_extensions": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {"type": "string"}
            }
          }
        }
      }
    },
    "deferred_trust_layers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "required": ["trigger", "action", "reason"]
      }
    }
  }
}
