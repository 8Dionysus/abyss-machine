{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abyss-machine.local/schemas/pytest-owner-lifecycle-census-request-v1.schema.json",
  "title": "Owner lifecycle census request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "scan_scope",
    "target_snapshot_digest",
    "target_identities",
    "bounds",
    "requested_at_ns",
    "expires_at_ns",
    "nonce",
    "request_digest"
  ],
  "properties": {
    "schema": {"const": "pytest-owner-lifecycle-census-request-v1"},
    "request_id": {"$ref": "#/$defs/text"},
    "scan_scope": {"$ref": "#/$defs/text"},
    "target_snapshot_digest": {"$ref": "#/$defs/digest"},
    "target_identities": {
      "type": "array",
      "maxItems": 65536,
      "items": {"$ref": "#/$defs/identity"}
    },
    "bounds": {"$ref": "#/$defs/bounds"},
    "requested_at_ns": {"type": "integer", "minimum": 1},
    "expires_at_ns": {"type": "integer", "minimum": 1},
    "nonce": {"$ref": "#/$defs/text"},
    "request_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000]*$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "identity": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0},
        {"type": "string", "enum": ["directory", "regular", "symlink", "special", "other"]}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_processes", "max_descriptors", "max_target_identities", "max_duration_ns"],
      "properties": {
        "max_processes": {"type": "integer", "minimum": 1, "maximum": 65536},
        "max_descriptors": {"type": "integer", "minimum": 1, "maximum": 262144},
        "max_target_identities": {"type": "integer", "minimum": 1, "maximum": 65536},
        "max_duration_ns": {"type": "integer", "minimum": 1, "maximum": 300000000000}
      }
    }
  }
}
