{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/8Dionysus/abyss-machine/schemas/active-organ-host-resource-storage-plan-reference.schema.json",
  "title": "OS Abyss active-organ host resource and storage plan reference",
  "description": "C19 reference-only host admission envelope over existing abyss-machine resource and storage plans. It never executes launch or mutates project roots.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "contract_name",
    "reference_id",
    "reference_version",
    "idempotency_key",
    "owner",
    "request",
    "capability_snapshot_ref",
    "resource_plan_ref",
    "storage_write_preflight_ref",
    "resource_plan_decision",
    "host_disposition",
    "softening_constraints",
    "blocked_reasons",
    "denied_reasons",
    "warnings",
    "source_refs",
    "resource_policy_pin",
    "storage_policy_pin",
    "rollback_ref",
    "produced_at",
    "expires_at",
    "plan_freshness",
    "validation_status",
    "content_digest",
    "launch_executed",
    "machine_owned_roots_only",
    "project_root_mutation",
    "stack_root_mutation",
    "memory_semantic_authority",
    "effect_authority",
    "owner_workload_effect"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "contract_id": {
      "const": "C19"
    },
    "contract_name": {
      "const": "HostResourceStoragePlanReference"
    },
    "reference_id": {
      "type": "string",
      "minLength": 1
    },
    "reference_version": {
      "type": "integer",
      "minimum": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "const": "abyss-machine"
    },
    "request": {
      "$ref": "#/$defs/host_request"
    },
    "capability_snapshot_ref": {
      "$ref": "#/$defs/capability_snapshot_ref"
    },
    "resource_plan_ref": {
      "$ref": "#/$defs/resource_plan_ref"
    },
    "storage_write_preflight_ref": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/storage_preflight_ref"
        }
      ]
    },
    "resource_plan_decision": {
      "enum": [
        "allow",
        "force_required",
        "deny"
      ]
    },
    "host_disposition": {
      "enum": [
        "start",
        "defer",
        "soften",
        "deny"
      ]
    },
    "softening_constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/softening_constraint"
      }
    },
    "blocked_reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "denied_reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/provenance_ref"
      }
    },
    "resource_policy_pin": {
      "$ref": "#/$defs/policy_pin"
    },
    "storage_policy_pin": {
      "$ref": "#/$defs/policy_pin"
    },
    "rollback_ref": {
      "$ref": "#/$defs/provenance_ref"
    },
    "produced_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "plan_freshness": {
      "enum": [
        "current",
        "stale",
        "unknown"
      ]
    },
    "validation_status": {
      "enum": [
        "valid",
        "partial",
        "failed",
        "invalid"
      ]
    },
    "content_digest": {
      "$ref": "#/$defs/digest"
    },
    "launch_executed": {
      "const": false
    },
    "machine_owned_roots_only": {
      "const": true
    },
    "project_root_mutation": {
      "const": "forbidden"
    },
    "stack_root_mutation": {
      "const": "forbidden"
    },
    "memory_semantic_authority": {
      "const": "none"
    },
    "effect_authority": {
      "const": "host_admission_only"
    },
    "owner_workload_effect": {
      "const": "start_defer_soften_or_deny_only"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "provenance_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_repo",
        "artifact_ref",
        "artifact_version",
        "artifact_digest"
      ],
      "properties": {
        "owner_repo": {
          "type": "string",
          "minLength": 1
        },
        "artifact_ref": {
          "type": "string",
          "minLength": 1
        },
        "artifact_version": {
          "type": "string",
          "minLength": 1
        },
        "artifact_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "capability_snapshot_ref": {
      "allOf": [
        {
          "$ref": "#/$defs/provenance_ref"
        },
        {
          "properties": {
            "owner_repo": {
              "const": "abyss-machine"
            },
            "artifact_version": {
              "const": "1.0.0"
            }
          }
        }
      ]
    },
    "resource_plan_ref": {
      "allOf": [
        {
          "$ref": "#/$defs/provenance_ref"
        },
        {
          "properties": {
            "owner_repo": {
              "const": "abyss-machine"
            },
            "artifact_version": {
              "const": "abyss_machine_resource_plan_v1"
            }
          }
        }
      ]
    },
    "storage_preflight_ref": {
      "allOf": [
        {
          "$ref": "#/$defs/provenance_ref"
        },
        {
          "properties": {
            "owner_repo": {
              "const": "abyss-machine"
            },
            "artifact_version": {
              "const": "abyss_machine_storage_write_preflight_v1"
            }
          }
        }
      ]
    },
    "policy_pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "policy_version",
        "decision_ref",
        "policy_digest"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "decision_ref": {
          "type": "string",
          "minLength": 1
        },
        "policy_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "host_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_owner",
        "workload_id",
        "workload_class",
        "kind",
        "activity",
        "memory_demand_mib",
        "storage_write_required",
        "requested_bytes",
        "target_class",
        "target_ref",
        "data_class",
        "risk_class"
      ],
      "properties": {
        "request_owner": {
          "type": "string",
          "minLength": 1
        },
        "workload_id": {
          "type": "string",
          "minLength": 1
        },
        "workload_class": {
          "enum": [
            "probe",
            "light",
            "medium",
            "heavy",
            "sustained"
          ]
        },
        "kind": {
          "enum": [
            "agent",
            "ai",
            "indexing",
            "eval",
            "storage",
            "generic"
          ]
        },
        "activity": {
          "enum": [
            "foreground",
            "background"
          ]
        },
        "memory_demand_mib": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "storage_write_required": {
          "type": "boolean"
        },
        "requested_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "target_class": {
          "enum": [
            "none",
            "host_cache",
            "host_runtime",
            "host_storage",
            "host_tmp"
          ]
        },
        "target_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/provenance_ref"
            }
          ]
        },
        "data_class": {
          "enum": [
            "D0",
            "D1",
            "D2",
            "D3"
          ]
        },
        "risk_class": {
          "enum": [
            "R0",
            "R1",
            "R2",
            "R3",
            "R4",
            "R5"
          ]
        }
      }
    },
    "softening_constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "constraint_ref"
      ],
      "properties": {
        "kind": {
          "enum": [
            "reduce_concurrency",
            "reduce_batch",
            "reduce_memory_demand",
            "use_existing_runtime",
            "defer_write",
            "other"
          ]
        },
        "constraint_ref": {
          "$ref": "#/$defs/provenance_ref"
        }
      }
    }
  }
}
