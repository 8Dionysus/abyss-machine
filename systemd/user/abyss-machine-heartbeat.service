[Unit]
Description=OS Abyss recurring Heartbeat pulse
Documentation=file://{{ABYSS_MACHINE_ETC}}/AGENTS.md
Documentation=file://{{ABYSS_MACHINE_STATE}}/heartbeats/AGENTS.md

[Service]
Type=oneshot
Nice=12
IOSchedulingClass=idle
CPUWeight=20
IOWeight=20
MemoryHigh=256M
TimeoutStartSec=3min
Environment=ABYSS_MACHINE_HEARTBEAT_TRIGGER=timer
ExecStart={{ABYSS_LOCAL_BIN_DIR}}/abyss-machine resource launch --class light --kind agent --unattended --memory-demand-mib 256 --demand-key abyss-machine-heartbeat --demand-owner abyss-machine-heartbeats --estimate-source compact-latest-readmodel --estimate-confidence high --success-on-block --no-thermal-sample --timeout 120 --json -- {{ABYSS_LOCAL_BIN_DIR}}/abyss-machine heartbeats pulse --compact --json
StandardOutput=null
StandardError=journal
