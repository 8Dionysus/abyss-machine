[Unit]
Description=Abyss Machine deep storage candidate evidence refresh
Documentation=file://{{ABYSS_MACHINE_ETC}}/AGENTS.md
Documentation=file://{{ABYSS_MACHINE_STATE}}/storage/AGENTS.md

[Service]
Type=oneshot
Nice=15
IOSchedulingClass=idle
CPUWeight=15
IOWeight=15
TimeoutStartSec=6min
ExecStart={{ABYSS_LOCAL_BIN_DIR}}/abyss-machine resource launch --class medium --kind indexing --unattended --timeout 300 --memory-demand-mib 3072 --demand-key abyss-machine:storage-candidates:bounded-deep --demand-owner abyss-machine-storage --estimate-source bounded-contract-default --estimate-confidence medium --no-thermal-sample --json -- {{ABYSS_LOCAL_BIN_DIR}}/abyss-machine storage candidates refresh --deep --if-due --json
StandardOutput=null
StandardError=journal
