[Unit]
Description=Run the admitted AoA raw-block storage owner through bounded host gates
Documentation=file://{{ABYSS_MACHINE_ETC}}/AGENTS.md
Documentation=file://{{ABYSS_MACHINE_STATE}}/storage/AGENTS.md
After=local-fs.target

[Service]
Type=oneshot
Nice=19
IOSchedulingClass=idle
CPUWeight=20
IOWeight=20
TimeoutStartSec=15min
ExecStart={{ABYSS_LOCAL_BIN_DIR}}/abyss-machine storage aoa-session-memory-compact --config {{ABYSS_MACHINE_ETC}}/aoa-session-memory-storage.json --json
StandardOutput=null
StandardError=journal
