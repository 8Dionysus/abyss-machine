[Unit]
Description=Abyss Machine owner-aware runtime admission

[Service]
Type=simple
UMask=0077
ExecStart={{ABYSS_LOCAL_BIN_DIR}}/abyss-machine resource admission serve
Restart=on-failure
RestartSec=2s
RuntimeDirectory=abyss-machine/resource
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
CPUWeight=20
IOWeight=20
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=%t/abyss-machine/resource
ProtectHome=read-only
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
RestrictRealtime=yes
LockPersonality=yes
StandardOutput=null
StandardError=journal

[Install]
WantedBy=default.target
