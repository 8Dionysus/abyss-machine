#!/usr/bin/env python3
"""Native Codex storage lifecycle entrypoint, source or installed package."""
from pathlib import Path
import fcntl
import os
import sys

source = Path(__file__).resolve().parents[1] / "src"
if (source / "abyss_machine").is_dir():
    sys.path.insert(0, str(source))
else:
    # Match the host launcher's exact generation; the legacy compatibility
    # directory can contain older modules even when the live CLI was refreshed.
    libexec = Path("/usr/local/libexec")
    refresh_fd = os.open(libexec / ".abyss-machine-code-refresh.lock", os.O_RDONLY | os.O_CLOEXEC)
    fcntl.flock(refresh_fd, fcntl.LOCK_SH)
    try:
        generation = (libexec / ".abyss-machine-code-current").resolve(strict=True)
        if generation.parent != (libexec / ".abyss-machine-code-generations").resolve(strict=True):
            raise RuntimeError("invalid host package generation")
        generation_fd = os.open(generation / ".active.lock", os.O_RDONLY | os.O_CLOEXEC)
        fcntl.flock(generation_fd, fcntl.LOCK_SH)
    finally:
        fcntl.flock(refresh_fd, fcntl.LOCK_UN)
        os.close(refresh_fd)
    sys.path.insert(0, str(generation))
from abyss_machine.codex_storage_lifecycle import main

raise SystemExit(main())
