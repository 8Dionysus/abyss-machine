CLI_LAUNCHER = """#!/usr/bin/env python3
import fcntl
import os
from pathlib import Path
import runpy
import sys

libexec = Path(__file__).resolve().parent
generations = libexec / ".abyss-machine-code-generations"
refresh_fd = os.open(libexec / ".abyss-machine-code-refresh.lock", os.O_RDONLY | os.O_CLOEXEC)
fcntl.flock(refresh_fd, fcntl.LOCK_SH)
try:
    generation = (libexec / ".abyss-machine-code-current").resolve(strict=True)
    if generation.parent != generations.resolve(strict=True):
        raise RuntimeError(f"invalid abyss-machine code generation: {generation}")
    generation_fd = os.open(generation / ".active.lock", os.O_RDONLY | os.O_CLOEXEC)
    fcntl.flock(generation_fd, fcntl.LOCK_SH)
finally:
    fcntl.flock(refresh_fd, fcntl.LOCK_UN)
    os.close(refresh_fd)
if str(generation) not in sys.path:
    sys.path.insert(0, str(generation))
module = "abyss_machine.cli"
if sys.argv[1:3] == ["resource", "codex-hook"]:
    del sys.argv[1:3]
    module = "abyss_machine.resource_codex_hook"
elif sys.argv[1:3] == ["storage", "codex"]:
    del sys.argv[1:3]
    module = "abyss_machine.codex_storage_lifecycle"
elif sys.argv[1:3] == ["storage", "process-probe"]:
    del sys.argv[1:3]
    module = "abyss_machine.storage_process_probe"
elif sys.argv[1:3] == ["storage", "capacity"]:
    del sys.argv[1:3]
    module = "abyss_machine.storage_capacity"
elif sys.argv[1:3] == ["storage", "aoa-session-memory-compact"]:
    del sys.argv[1:3]
    module = "abyss_machine.aoa_session_memory_storage_runner"
elif sys.argv[1:3] == ["storage", "aoa-session-memory-compact-child"]:
    del sys.argv[1:3]
    sys.argv.insert(1, "child")
    module = "abyss_machine.aoa_session_memory_storage_runner"
runpy.run_module(module, run_name="__main__")
"""
CODE_GENERATIONS_DIR_NAME = ".abyss-machine-code-generations"
CODE_CURRENT_LINK_NAME = ".abyss-machine-code-current"
CODE_GENERATION_ACTIVE_LOCK_NAME = ".active.lock"
CODE_GENERATIONS_TO_KEEP = 2

