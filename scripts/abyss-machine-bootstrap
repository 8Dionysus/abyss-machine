def default_artifact_registry_dir(policy: AbyssMachinePathPolicy) -> Path:
    return policy.state_path("artifacts", "bundle-registry")


def _path_is_inside(path: Path, root: Path) -> bool:
    try:
        path.resolve(strict=False).relative_to(root.resolve(strict=False))
    except ValueError:
        return False
    return True


def _path_is_strictly_inside(path: Path, root: Path) -> bool:
    path_resolved = path.resolve(strict=False)
    root_resolved = root.resolve(strict=False)
    return path_resolved != root_resolved and _path_is_inside(path_resolved, root_resolved)


def install_targets_are_isolated(policy: AbyssMachinePathPolicy) -> bool:
    return _targets_are_isolated_from_live_roots(
        (
            *policy.install_roots,
            policy.local_bin_dir,
            policy.local_libexec_dir,
            policy.systemd_system_dir,
            policy.systemd_user_dir or policy.home / ".config/systemd/user",
        )
    )


def refresh_code_targets_are_isolated(policy: AbyssMachinePathPolicy) -> bool:
    values = policy.render_vars()
    return _targets_are_isolated_from_live_roots(
        (
            policy.local_bin_dir,
            policy.local_libexec_dir,
            public_seed_share_root(values),
        )
    )


def _targets_are_isolated_from_live_roots(target_roots: tuple[Path, ...]) -> bool:
    live_policy = DEFAULT_PATH_POLICY
    live_roots = (
        *live_policy.install_roots,
        live_policy.local_bin_dir,
        live_policy.local_libexec_dir,
        live_policy.systemd_system_dir,
        live_policy.systemd_user_dir or live_policy.home / ".config/systemd/user",
    )
    rehearsal_roots = (live_policy.tmp_root,)
    return not any(
        _path_is_inside(target, live_root)
        and not any(_path_is_strictly_inside(target, rehearsal_root) for rehearsal_root in rehearsal_roots)
        for target in target_roots
        for live_root in live_roots
    )


def path_policy_from_args(args: argparse.Namespace) -> AbyssMachinePathPolicy:
    return AbyssMachinePathPolicy.from_values(
        user=args.user,
        home=args.home,
        etc_root=args.etc_root,
        state_root=args.state_root,
        srv_root=args.srv_root,
        run_root=args.run_root,
        abyss_os_root=args.abyss_os_root,
        vault_mount=args.vault_mount,
        local_bin_dir=args.local_bin_dir,
        local_libexec_dir=args.local_libexec_dir,
        systemd_system_dir=args.systemd_system_dir,
        systemd_user_dir=args.systemd_user_dir,
    )


def default_vars(args: argparse.Namespace) -> dict[str, str]:
    return path_policy_from_args(args).render_vars()


def render_text(text: str, values: dict[str, str]) -> str:
    for key, value in values.items():
        text = text.replace("{{" + key + "}}", value)
    return text


def copy_tree(
    source: Path,
    target: Path,
    *,
    values: dict[str, str],
    apply: bool,
    actions: list[dict[str, Any]],
) -> None:
    for path in sorted(source.rglob("*")):
        rel = path.relative_to(source)
        dest = target / rel
        if path.is_dir():
            if apply:
                dest.mkdir(parents=True, exist_ok=True)
            actions.append({"action": "mkdir", "path": str(dest)})
            continue
        if path.is_symlink():
            continue
        try:
            data = path.read_text(encoding="utf-8")
            rendered = render_text(data, values)
            if apply:
                dest.parent.mkdir(parents=True, exist_ok=True)
                dest.write_text(rendered, encoding="utf-8")
                shutil.copymode(path, dest)
            actions.append({"action": "render", "source": str(path), "target": str(dest)})
        except UnicodeDecodeError:
            if apply:
                dest.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(path, dest)
            actions.append({"action": "copy_binary", "source": str(path), "target": str(dest)})


def ensure_roots(values: dict[str, str], *, apply: bool, actions: list[dict[str, Any]]) -> None:
    policy = AbyssMachinePathPolicy.from_values(
        user=values["ABYSS_USER"],
        home=values["ABYSS_USER_HOME"],
        etc_root=values["ABYSS_MACHINE_ETC"],
        state_root=values["ABYSS_MACHINE_STATE"],
        srv_root=values["ABYSS_MACHINE_SRV"],
        run_root=values["ABYSS_MACHINE_RUN"],
        abyss_os_root=values["ABYSS_OS_ROOT"],
        vault_mount=values["ABYSS_VAULT_MOUNT"],
        local_bin_dir=values["ABYSS_LOCAL_BIN_DIR"],
        local_libexec_dir=values["ABYSS_LOCAL_LIBEXEC_DIR"],
    )
    for root_path in policy.install_roots:
        root = str(root_path)
        if apply:
            root_path.mkdir(parents=True, exist_ok=True)
        actions.append({"action": "ensure_root", "path": root})


def _path_lexists(path: Path) -> bool:
    return os.path.lexists(path)


def _remove_projection_path(path: Path) -> None:
    if not _path_lexists(path):
        return
    if path.is_symlink() or not path.is_dir():
        path.unlink()
        return
    shutil.rmtree(path)


def _projection_stage_path(target: Path) -> Path:
    return target.with_name(
        f".{target.name}.abyss-stage-{os.getpid()}-{secrets.token_hex(8)}"
    )


def _stage_projection_tree(source: Path, target: Path) -> Path:
    target.parent.mkdir(parents=True, exist_ok=True)
    if _path_lexists(target) and (target.is_symlink() or not target.is_dir()):
        raise OSError(errno.ENOTDIR, "tree projection target is not a directory", target)
    stage = _projection_stage_path(target)
    shutil.copytree(
        source,
        stage,
        ignore=shutil.ignore_patterns("__pycache__", "*.pyc"),
    )
    return stage


def _stage_projection_symlink(link_target: Path, target: Path) -> Path:
    target.parent.mkdir(parents=True, exist_ok=True)
    if _path_lexists(target) and target.is_dir() and not target.is_symlink():
        raise OSError(errno.EISDIR, "symlink projection target is a directory", target)
    stage = _projection_stage_path(target)
    stage.symlink_to(link_target)
    return stage


def _stage_projection_file(content: str, target: Path, *, mode: int) -> Path:
    target.parent.mkdir(parents=True, exist_ok=True)
    if _path_lexists(target) and target.is_dir() and not target.is_symlink():
        raise OSError(errno.EISDIR, "file projection target is a directory", target)
    stage = _projection_stage_path(target)
    stage.write_text(content, encoding="utf-8")
    stage.chmod(mode)
    return stage


def _rename_exchange(left: Path, right: Path) -> None:
    renameat2 = getattr(ctypes.CDLL(None, use_errno=True), "renameat2", None)
    if renameat2 is None:
        raise OSError(errno.ENOSYS, "renameat2 is required for atomic code refresh")
    renameat2.argtypes = [
        ctypes.c_int,
        ctypes.c_char_p,
        ctypes.c_int,
        ctypes.c_char_p,
        ctypes.c_uint,
    ]
    renameat2.restype = ctypes.c_int
    result = renameat2(
        -100,
        os.fsencode(left),
        -100,
        os.fsencode(right),
        2,
    )
    if result != 0:
        error_number = ctypes.get_errno()
        raise OSError(
            error_number,
            os.strerror(error_number),
            f"{left} <-> {right}",
        )


def _commit_projection(staged: list[tuple[Path, Path]]) -> None:
    committed: list[tuple[Path, Path, bool]] = []
    try:
        for stage, target in staged:
            target_existed = _path_lexists(target)
            if target_existed:
                _rename_exchange(stage, target)
            else:
                os.replace(stage, target)
            committed.append((stage, target, target_existed))
    except Exception:
        for stage, target, target_existed in reversed(committed):
            if target_existed:
                _rename_exchange(stage, target)
            elif _path_lexists(target):
                os.replace(target, stage)
        raise
    else:
        for stage, _, _ in committed:
            _remove_projection_path(stage)


def _open_code_refresh_lock(path: Path, *, user: str) -> int:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_CLOEXEC, 0o644)
    try:
        if os.geteuid() == 0:
            account = pwd.getpwnam(user)
            os.fchown(fd, account.pw_uid, account.pw_gid)
        # The installed launcher is a system-wide entrypoint and opens these
        # locks read-only. Keep mutation owner-only while allowing a runtime
        # user other than the privileged installer to acquire shared locks.
        os.fchmod(fd, 0o644)
    except Exception:
        os.close(fd)
        raise
    return fd


def _entrypoint_uses_managed_launcher(path: Path) -> bool:
    if not path.is_file() or path.is_symlink():
        return False
    try:
        return path.read_text(encoding="utf-8") == CLI_LAUNCHER
    except (OSError, UnicodeDecodeError):
        return False


def _legacy_entrypoint_processes(
    entrypoints: tuple[Path, ...],
) -> list[int]:
    expected = {os.fsencode(str(path)) for path in entrypoints}
    legacy: list[int] = []
    for proc_path in Path("/proc").glob("[0-9]*"):
        pid = int(proc_path.name)
        if pid == os.getpid():
            continue
        try:
            argv = {
                item
                for item in (proc_path / "cmdline").read_bytes().split(b"\0")
                if item
            }
        except (FileNotFoundError, PermissionError, OSError):
            continue
        if not argv.intersection(expected):
            continue
        legacy.append(pid)
    return sorted(legacy)


def _tree_content_digest(root: Path) -> str:
    digest = hashlib.sha256()
    for path in sorted(root.rglob("*")):
        if not path.is_file() or "__pycache__" in path.parts or path.suffix == ".pyc":
            continue
        relative = path.relative_to(root).as_posix().encode("utf-8")
        digest.update(relative)
        digest.update(b"\0")
        with path.open("rb") as handle:
            for chunk in iter(lambda: handle.read(1024 * 1024), b""):
                digest.update(chunk)
        digest.update(b"\0")
    return digest.hexdigest()


def _prepare_code_generation(
    generations_root: Path,
    *,
    user: str,
) -> tuple[Path, int, bool]:
    generation_id = _tree_content_digest(SOURCE_PACKAGE_ROOT)
    generation_root = generations_root / generation_id
    package_root = generation_root / "abyss_machine"
    modules = sorted(SOURCE_PACKAGE_ROOT.glob("*.py"))
    if generation_root.exists():
        if (
            generation_root.is_symlink()
            or not package_root.is_dir()
            or _tree_content_digest(package_root) != generation_id
        ):
            raise RuntimeError(f"code generation digest mismatch: {generation_root}")
        lock_fd = _open_code_refresh_lock(
            generation_root / CODE_GENERATION_ACTIVE_LOCK_NAME,
            user=user,
        )
        os.close(lock_fd)
        return generation_root, len(modules), False

    generations_root.mkdir(parents=True, exist_ok=True)
    stage = _projection_stage_path(generation_root)
    try:
        shutil.copytree(
            SOURCE_PACKAGE_ROOT,
            stage / "abyss_machine",
            ignore=shutil.ignore_patterns("__pycache__", "*.pyc"),
        )
        compiled_module_count = 0
        for module_path in sorted((stage / "abyss_machine").glob("*.py")):
            compiled_path = Path(importlib.util.cache_from_source(str(module_path)))
            compiled_path.parent.mkdir(parents=True, exist_ok=True)
            py_compile.compile(str(module_path), cfile=str(compiled_path), doraise=True)
            compiled_module_count += 1
        lock_fd = _open_code_refresh_lock(
            stage / CODE_GENERATION_ACTIVE_LOCK_NAME,
            user=user,
        )
        os.close(lock_fd)
        if _tree_content_digest(stage / "abyss_machine") != generation_id:
            raise RuntimeError(f"staged code generation digest mismatch: {stage}")
        os.replace(stage, generation_root)
        return generation_root, compiled_module_count, True
    finally:
        _remove_projection_path(stage)


def _prune_inactive_code_generations(
    generations_root: Path,
    *,
    current_generation: Path,
) -> tuple[list[str], list[str]]:
    generations = sorted(
        (
            path
            for path in generations_root.iterdir()
            if path.is_dir() and not path.is_symlink() and path != current_generation
        ),
        key=lambda path: path.stat().st_mtime_ns,
        reverse=True,
    )
    keep_inactive = max(0, CODE_GENERATIONS_TO_KEEP - 1)
    removed: list[str] = []
    deferred: list[str] = []
    for generation in generations[keep_inactive:]:
        lock_path = generation / CODE_GENERATION_ACTIVE_LOCK_NAME
        try:
            lock_fd = os.open(lock_path, os.O_RDWR | os.O_CLOEXEC)
        except OSError:
            deferred.append(str(generation))
            continue
        try:
            try:
                fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                deferred.append(str(generation))
                continue
            shutil.rmtree(generation)
            removed.append(str(generation))
        finally:
            os.close(lock_fd)
    return removed, deferred


def install_code_projection(
    values: dict[str, str],
    *,
    apply: bool,
    actions: list[dict[str, Any]],
) -> None:
    source = REPO_ROOT / "src" / "abyss_machine" / "cli.py"
    libexec_dir = Path(values["ABYSS_LOCAL_LIBEXEC_DIR"])
    libexec = libexec_dir / "abyss-machine"
    compatibility_package_target = libexec_dir / "abyss_machine"
    generations_root = libexec_dir / CODE_GENERATIONS_DIR_NAME
    generation_id = _tree_content_digest(SOURCE_PACKAGE_ROOT)
    current_generation = generations_root / generation_id
    current_link = libexec_dir / CODE_CURRENT_LINK_NAME
    package_target = current_generation / "abyss_machine"
    bin_path = Path(values["ABYSS_LOCAL_BIN_DIR"]) / "abyss-machine"
    compiled_cli = Path(importlib.util.cache_from_source(str(package_target / "cli.py")))
    compiled_module_count = 0
    share_root = public_seed_share_root(values)
    installed_roots = [str(share_root / source_root.name) for source_root in PUBLIC_SEED_SOURCE_ROOTS]
    refresh_lock = libexec.parent / ".abyss-machine-code-refresh.lock"
    legacy_entrypoint_processes_observed = 0
    legacy_package_preserved = False
    generation_created = False
    generations_removed: list[str] = []
    generations_deferred: list[str] = []
    if apply:
        staged: list[tuple[Path, Path]] = []
        lock_fd: int | None = None
        try:
            managed_launcher_existed = _entrypoint_uses_managed_launcher(libexec)
            if not managed_launcher_existed:
                legacy_entrypoint_processes_observed = len(
                    _legacy_entrypoint_processes((bin_path, libexec))
                )

            for source_root in PUBLIC_SEED_SOURCE_ROOTS:
                target_root = share_root / source_root.name
                staged.append((_stage_projection_tree(source_root, target_root), target_root))

            current_stage = _stage_projection_symlink(
                Path(CODE_GENERATIONS_DIR_NAME) / generation_id,
                current_link,
            )
            libexec_stage = _stage_projection_file(CLI_LAUNCHER, libexec, mode=0o755)
            bin_stage = _stage_projection_symlink(libexec, bin_path)
            staged.extend(
                (
                    (current_stage, current_link),
                    (libexec_stage, libexec),
                    (bin_stage, bin_path),
                )
            )
            if (
                not _path_lexists(compatibility_package_target)
                or compatibility_package_target.is_symlink()
            ):
                compatibility_stage = _stage_projection_symlink(
                    Path(CODE_CURRENT_LINK_NAME) / "abyss_machine",
                    compatibility_package_target,
                )
                staged.append((compatibility_stage, compatibility_package_target))
            else:
                legacy_package_preserved = True

            lock_fd = _open_code_refresh_lock(refresh_lock, user=values["ABYSS_USER"])
            fcntl.flock(lock_fd, fcntl.LOCK_EX)
            (
                prepared_generation,
                compiled_module_count,
                generation_created,
            ) = _prepare_code_generation(
                generations_root,
                user=values["ABYSS_USER"],
            )
            if prepared_generation != current_generation:
                raise RuntimeError(
                    f"prepared code generation mismatch: {prepared_generation}"
                )
            _commit_projection(staged)
            generations_removed, generations_deferred = _prune_inactive_code_generations(
                generations_root,
                current_generation=current_generation,
            )
        except Exception:
            if generation_created:
                try:
                    selected_generation = current_link.resolve(strict=True)
                except (FileNotFoundError, OSError):
                    selected_generation = None
                if selected_generation != current_generation:
                    _remove_projection_path(current_generation)
            raise
        finally:
            if lock_fd is not None:
                os.close(lock_fd)
            for stage, _ in staged:
                _remove_projection_path(stage)
    modules = sorted(path.name for path in SOURCE_PACKAGE_ROOT.glob("*.py"))
    actions.append({
        "action": "install_cli",
        "source": str(source),
        "target": str(libexec),
        "package_source": str(SOURCE_PACKAGE_ROOT),
        "package_target": str(package_target),
        "package_modules": modules,
        "compiled_cli": str(compiled_cli),
        "compiled_module_count": compiled_module_count if apply else len(modules),
        "bytecode_policy": "compile_installed_package_once",
        "symlink": str(bin_path),
        "libexec_entrypoint": "stable_generation_python_module_launcher",
        "projection_strategy": "immutable_generation_then_atomic_current_switch",
        "atomic_visibility": True,
        "refresh_lock": str(refresh_lock),
        "generation_id": generation_id,
        "generation_root": str(current_generation),
        "current_generation": str(current_link),
        "generation_active_lock": str(
            current_generation / CODE_GENERATION_ACTIVE_LOCK_NAME
        ),
        "compatibility_package_target": str(compatibility_package_target),
        "legacy_package_preserved": legacy_package_preserved,
        "legacy_entrypoint_processes_observed": legacy_entrypoint_processes_observed,
        "legacy_entrypoint_drain_required": False,
        "generation_gc": {
            "keep": CODE_GENERATIONS_TO_KEEP,
            "removed": generations_removed,
            "deferred_active": generations_deferred,
        },
    })
    actions.append({
        "action": "install_public_seed",
        "source_roots": [str(path) for path in PUBLIC_SEED_SOURCE_ROOTS],
        "target": str(share_root),
        "installed_roots": installed_roots,
        "projection_strategy": "sibling_stage_then_rename_exchange",
        "atomic_visibility": True,
    })


def public_seed_share_root(values: dict[str, str]) -> Path:
    return Path(values["ABYSS_LOCAL_LIBEXEC_DIR"]).parent / "share" / "abyss-machine"


def command_payload(command: str, ok: bool, actions: list[dict[str, Any]], **extra: Any) -> dict[str, Any]:
    return {
        "schema": SCHEMA,
        "version": VERSION,
        "command": command,
        "ok": ok,
        "actions": actions,
        **extra,
    }


def emit(payload: dict[str, Any], *, json_output: bool) -> None:
    if json_output:
        print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True))
        return
    print(f"{payload['command']}: {'ok' if payload.get('ok') else 'failed'}")
    for action in payload.get("actions", []):
        print(f"- {action.get('action')}: {action.get('target') or action.get('path') or action.get('source')}")


def install_artifact_admission(
    args: argparse.Namespace,
    policy: AbyssMachinePathPolicy,
    *,
    mutation_name: str = "install",
    targets_are_isolated: bool | None = None,
    isolation_claim: str = "all install targets",
) -> dict[str, Any]:
    artifact_class = str(args.artifact_class or "bootstrap_install_bundle")
    consumer_intent = str(args.artifact_consumer_intent or artifact_bundles.consumer_intent_for_artifact_class(artifact_class))
    registry_dir = Path(args.artifact_registry_dir) if args.artifact_registry_dir else default_artifact_registry_dir(policy)
    base = {
        "schema": "abyss_machine_bootstrap_artifact_admission_v1",
        "required": bool(args.require_artifact_trust_gate),
        "artifact_class": artifact_class,
        "consumer_intent": consumer_intent,
        "registry_dir": str(registry_dir),
        "subject_digest": str(args.artifact_subject_digest or "") or None,
        "record_id": str(args.artifact_record_id or "") or None,
        "source_repo": str(args.artifact_source_repo or "") or None,
        "trust_root_mode": str(args.artifact_trust_root_mode or "") or None,
        "require_latest": not bool(args.allow_non_latest_artifact),
    }
    if not args.require_artifact_trust_gate:
        isolated = install_targets_are_isolated(policy) if targets_are_isolated is None else bool(targets_are_isolated)
        if bool(args.apply) and not isolated:
            return {
                **base,
                "ok": False,
                "verdict": "skip_rejected",
                "trust_gate": None,
                "errors": ["artifact_trust_gate_skip_not_allowed_for_live_apply"],
                "claim_limit": (
                    f"Bootstrap {mutation_name} --apply may skip artifact trust-gate only when "
                    f"{isolation_claim} are isolated from live default roots."
                ),
            }
        return {
            **base,
            "ok": True,
            "verdict": "not_required",
            "trust_gate": None,
            "errors": [],
            "claim_limit": "Bootstrap install skips artifact trust-gate only through explicit local-development opt-out.",
        }

    if not str(args.artifact_subject_digest or "") and not str(args.artifact_record_id or ""):
        return {
            **base,
            "ok": False,
            "verdict": "deny",
            "trust_gate": None,
            "freshness_gate": None,
            "errors": ["artifact_trust_gate_selector_required"],
            "claim_limit": (
                "Bootstrap install artifact trust-gate requires an explicit artifact subject digest "
                "or record id so admission cannot silently fall back to the latest unrelated record."
            ),
        }

    gate = artifact_bundles.trust_gate(
        registry_dir,
        artifact_class=artifact_class,
        subject_digest=str(args.artifact_subject_digest or ""),
        record_id=str(args.artifact_record_id or ""),
        consumer_intent=consumer_intent,
        expected_source_repo=str(args.artifact_source_repo or ""),
        expected_trust_root_mode=str(args.artifact_trust_root_mode or ""),
        require_latest=not bool(args.allow_non_latest_artifact),
    )
    gate_ok = bool(gate.get("ok"))
    freshness_gate = None
    freshness_errors: list[str] = []
    if gate_ok:
        affected = artifact_bundles.artifact_affected(
            artifact_class=artifact_class,
            registry_dir=registry_dir,
            record_id=str(gate.get("record_id") or args.artifact_record_id or ""),
            subject_digest=str(args.artifact_subject_digest or ""),
            require_latest=not bool(args.allow_non_latest_artifact),
        )
        affected_rows = [
            row
            for row in affected.get("rows", [])
            if isinstance(row, dict)
        ]
        blocking_rows = [
            row
            for row in affected_rows
            if isinstance(row.get("drift"), dict)
            and row["drift"].get("operationally_blocking") is True
        ]
        for row in blocking_rows:
            reasons = [str(item) for item in row.get("reasons", []) if str(item)]
            reason_text = ",".join(reasons) if reasons else str(row.get("verdict") or "source_freshness_blocking")
            freshness_errors.append(f"artifact_source_freshness_blocking:{row.get('artifact_class')}:{reason_text}")
        freshness_gate = {
            "schema": "abyss_machine_bootstrap_artifact_freshness_gate_v1",
            "ok": bool(affected.get("ok")) and not freshness_errors,
            "verdict": "allow" if bool(affected.get("ok")) and not freshness_errors else "deny",
            "artifact_class": artifact_class,
            "registry_dir": str(registry_dir),
            "summary": affected.get("summary"),
            "blocking_rows": [
                {
                    "artifact_class": row.get("artifact_class"),
                    "verdict": row.get("verdict"),
                    "freshness": row.get("freshness"),
                    "reasons": row.get("reasons", []),
                    "drift": row.get("drift"),
                    "registry": row.get("registry"),
                    "abi_subject_status": row.get("abi_subject_status"),
                }
                for row in blocking_rows
            ],
            "errors": freshness_errors,
            "claim_limit": (
                "Bootstrap install treats current source freshness as part of consumer admission; "
                "a stale ABI or blocking drift cannot be consumed through an otherwise valid registry trust-gate record."
            ),
        }
    ok = gate_ok and (not isinstance(freshness_gate, dict) or freshness_gate.get("ok") is True)
    verdict = str(gate.get("verdict") or "unknown")
    if gate_ok and isinstance(freshness_gate, dict) and freshness_gate.get("ok") is not True:
        verdict = "deny"
    return {
        **base,
        "ok": ok,
        "verdict": verdict,
        "record_id": gate.get("record_id") or base["record_id"],
        "latest_record_id": gate.get("latest_record_id"),
        "trust_gate": gate,
        "freshness_gate": freshness_gate,
        "errors": [] if ok else [*([str(item) for item in gate.get("reasons", [])] if not gate_ok else []), *freshness_errors],
        "claim_limit": "Bootstrap install consumption is fail-closed when artifact trust-gate admission is required.",
    }


def cmd_doctor(args: argparse.Namespace) -> int:
    actions: list[dict[str, Any]] = []
    values = default_vars(args)
    checks = {
        "repo_root_exists": REPO_ROOT.exists(),
        "cli_source_exists": (REPO_ROOT / "src" / "abyss_machine" / "cli.py").exists(),
        "package_source_exists": SOURCE_PACKAGE_ROOT.is_dir(),
        "config_templates_exist": CONFIG_TEMPLATE_ROOT.exists(),
        "systemd_templates_exist": SYSTEMD_TEMPLATE_ROOT.exists(),
        "artifact_policy_exists": (REPO_ROOT / "manifests" / "artifact_signature_policy.manifest.json").is_file(),
        "contract_abi_exists": (REPO_ROOT / "generated" / "contract_abi_signatures.min.json").is_file(),
        "python": sys.version.split()[0],
        "profile_known": args.profile in PROFILE_UNITS,
    }
    ok = all(value for value in checks.values() if isinstance(value, bool))
    actions.append({"action": "doctor", "dry_run": bool(args.dry_run), "profile": args.profile})
    payload = command_payload("doctor", ok, actions, vars=values, checks=checks)
    emit(payload, json_output=args.json)
    return 0 if ok else 1


def cmd_render(args: argparse.Namespace) -> int:
    actions: list[dict[str, Any]] = []
    values = default_vars(args)
    target = Path(args.render_root) if args.render_root else Path(args.etc_root)
    copy_tree(CONFIG_TEMPLATE_ROOT, target, values=values, apply=bool(args.apply), actions=actions)
    payload = command_payload("render", True, actions, profile=args.profile, dry_run=not args.apply, target=str(target))
    emit(payload, json_output=args.json)
    return 0


def cmd_install(args: argparse.Namespace) -> int:
    actions: list[dict[str, Any]] = []
    policy = path_policy_from_args(args)
    values = policy.render_vars()
    apply = bool(args.apply)
    artifact_admission = install_artifact_admission(args, policy)
    actions.append({
        "action": "artifact_trust_gate",
        "required": artifact_admission["required"],
        "artifact_class": artifact_admission["artifact_class"],
        "consumer_intent": artifact_admission["consumer_intent"],
        "registry_dir": artifact_admission["registry_dir"],
        "verdict": artifact_admission["verdict"],
        "record_id": artifact_admission.get("record_id"),
        "latest_record_id": artifact_admission.get("latest_record_id"),
    })
    if isinstance(artifact_admission.get("freshness_gate"), dict):
        actions[0]["freshness_verdict"] = artifact_admission["freshness_gate"].get("verdict")
    if not artifact_admission["ok"]:
        payload = command_payload(
            "install",
            False,
            actions,
            profile=args.profile,
            dry_run=not apply,
            artifact_admission=artifact_admission,
        )
        emit(payload, json_output=args.json)
        return 1
    ensure_roots(values, apply=apply, actions=actions)
    copy_tree(CONFIG_TEMPLATE_ROOT, Path(args.etc_root), values=values, apply=apply, actions=actions)
    copy_tree(SYSTEMD_TEMPLATE_ROOT / "system", policy.systemd_system_dir, values=values, apply=apply, actions=actions)
    copy_tree(SYSTEMD_TEMPLATE_ROOT / "user", policy.systemd_user_dir or policy.home / ".config/systemd/user", values=values, apply=apply, actions=actions)
    install_code_projection(values, apply=apply, actions=actions)
    payload = command_payload("install", True, actions, profile=args.profile, dry_run=not apply, artifact_admission=artifact_admission)
    emit(payload, json_output=args.json)
    return 0


def cmd_refresh_code(args: argparse.Namespace) -> int:
    actions: list[dict[str, Any]] = []
    policy = path_policy_from_args(args)
    values = policy.render_vars()
    apply = bool(args.apply)
    artifact_admission = install_artifact_admission(
        args,
        policy,
        mutation_name="refresh-code",
        targets_are_isolated=refresh_code_targets_are_isolated(policy),
        isolation_claim="refresh-code mutation targets",
    )
    actions.append({
        "action": "artifact_trust_gate",
        "required": artifact_admission["required"],
        "artifact_class": artifact_admission["artifact_class"],
        "consumer_intent": artifact_admission["consumer_intent"],
        "registry_dir": artifact_admission["registry_dir"],
        "verdict": artifact_admission["verdict"],
        "record_id": artifact_admission.get("record_id"),
        "latest_record_id": artifact_admission.get("latest_record_id"),
    })
    if isinstance(artifact_admission.get("freshness_gate"), dict):
        actions[0]["freshness_verdict"] = artifact_admission["freshness_gate"].get("verdict")
    if not artifact_admission["ok"]:
        payload = command_payload(
            "refresh-code",
            False,
            actions,
            dry_run=not apply,
            artifact_admission=artifact_admission,
            mutation_scope="cli_package_and_public_seed_only",
            config_rendered=False,
            systemd_rendered=False,
        )
        emit(payload, json_output=args.json)
        return 1
    install_code_projection(values, apply=apply, actions=actions)
    payload = command_payload(
        "refresh-code",
        True,
        actions,
        dry_run=not apply,
        artifact_admission=artifact_admission,
        mutation_scope="cli_package_and_public_seed_only",
        config_rendered=False,
        systemd_rendered=False,
    )
    emit(payload, json_output=args.json)
    return 0


def cmd_enable_profile(args: argparse.Namespace) -> int:
    actions: list[dict[str, Any]] = []
    units = PROFILE_UNITS[args.profile]
    apply = bool(args.apply)
    for scope, names in units.items():
        for name in names:
            command = ["systemctl"]
            if scope == "user":
                command.append("--user")
            command.extend(["enable"])
            if args.now:
                command.append("--now")
            command.append(name)
            actions.append({"action": "enable_unit", "scope": scope, "unit": name, "command": command})
            if apply:
                subprocess.run(command, check=True)
    payload = command_payload("enable-profile", True, actions, profile=args.profile, dry_run=not apply)
    emit(payload, json_output=args.json)
    return 0


def add_common_options(parser: argparse.ArgumentParser) -> None:
    defaults = DEFAULT_PATH_POLICY.cli_defaults()
    parser.add_argument("--profile", default="linux-systemd-core", choices=sorted(PROFILE_UNITS))
    parser.add_argument("--user", default=defaults["user"])
    parser.add_argument("--home", default=None)
    parser.add_argument("--etc-root", default=defaults["etc_root"])
    parser.add_argument("--state-root", default=defaults["state_root"])
    parser.add_argument("--srv-root", default=defaults["srv_root"])
    parser.add_argument("--run-root", default=defaults["run_root"])
    parser.add_argument("--abyss-os-root", default=defaults["abyss_os_root"])
    parser.add_argument("--vault-mount", default=defaults["vault_mount"])
    parser.add_argument("--local-bin-dir", default=defaults["local_bin_dir"])
    parser.add_argument("--local-libexec-dir", default=defaults["local_libexec_dir"])
    parser.add_argument("--systemd-system-dir", default=defaults["systemd_system_dir"])
    parser.add_argument("--systemd-user-dir", default=None)
    parser.add_argument("--json", action="store_true")


def add_artifact_gate_options(parser: argparse.ArgumentParser) -> None:
    artifact_gate = parser.add_mutually_exclusive_group()
    artifact_gate.add_argument(
        "--require-artifact-trust-gate",
        dest="require_artifact_trust_gate",
        action="store_true",
        default=True,
        help="deny bootstrap mutation unless durable artifact trust-gate allows the selected install bundle; this is the default",
    )
    artifact_gate.add_argument(
        "--skip-artifact-trust-gate",
        dest="require_artifact_trust_gate",
        action="store_false",
        help="explicit local-development opt-out for isolated projection rehearsals; production mutations remain fail-closed",
    )
    parser.add_argument("--artifact-registry-dir", default="", help="bundle registry root for bootstrap install admission")
    parser.add_argument("--artifact-class", default="bootstrap_install_bundle", help="artifact class consumed by this bootstrap mutation")
    parser.add_argument("--artifact-subject-digest", default="", help="expected install bundle subject digest")
    parser.add_argument("--artifact-record-id", default="", help="expected install bundle registry record id")
    parser.add_argument("--artifact-consumer-intent", default="installer", help="trust-gate consumer intent for bootstrap install")
    parser.add_argument("--artifact-source-repo", default="abyss-machine", help="expected source repo for bootstrap install material")
    parser.add_argument(
        "--artifact-trust-root-mode",
        default="",
        choices=("", *artifact_bundles.TRUST_ROOT_MODES),
        help="expected trust root mode for bootstrap install material",
    )
    parser.add_argument("--allow-non-latest-artifact", action="store_true", help="permit a selected non-latest install bundle record")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Render and install the portable abyss-machine seed.")
    sub = parser.add_subparsers(dest="command", required=True)

    doctor = sub.add_parser("doctor")
    add_common_options(doctor)
    doctor.add_argument("--dry-run", action="store_true")
    doctor.set_defaults(func=cmd_doctor)

    render = sub.add_parser("render")
    add_common_options(render)
    render.add_argument("--render-root")
    render.add_argument("--dry-run", action="store_true")
    render.add_argument("--apply", action="store_true")
    render.set_defaults(func=cmd_render)

    install = sub.add_parser("install")
    add_common_options(install)
    install.add_argument("--dry-run", action="store_true")
    install.add_argument("--apply", action="store_true")
    add_artifact_gate_options(install)
    install.set_defaults(func=cmd_install)

    refresh_code = sub.add_parser("refresh-code")
    add_common_options(refresh_code)
    refresh_code.add_argument("--dry-run", action="store_true")
    refresh_code.add_argument("--apply", action="store_true")
    add_artifact_gate_options(refresh_code)
    refresh_code.set_defaults(func=cmd_refresh_code)

    enable = sub.add_parser("enable-profile")
    add_common_options(enable)
    enable.add_argument("--dry-run", action="store_true")
    enable.add_argument("--apply", action="store_true")
    enable.add_argument("--now", action="store_true")
    enable.set_defaults(func=cmd_enable_profile)
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    return int(args.func(args))


if __name__ == "__main__":
    raise SystemExit(main())
